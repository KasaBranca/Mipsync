cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED WORK_DIR OR NOT DEFINED DEPLOY_SCRIPT)
    message(FATAL_ERROR "Pass WORK_DIR and DEPLOY_SCRIPT")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}/build/skills/mipsync-cli")
file(WRITE "${WORK_DIR}/build/skills/mipsync-cli/SKILL.md" "current skill")
foreach(_version IN ITEMS v2026.10.18 v1.0.0f2 v1.0.0f10)
    file(MAKE_DIRECTORY "${WORK_DIR}/installs/${_version}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DBUILD_DIR=${WORK_DIR}/build" "-DINSTALLS_ROOT=${WORK_DIR}/installs"
    -DSKILLS_ONLY=ON -P "${DEPLOY_SCRIPT}" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT EXISTS "${WORK_DIR}/installs/v1.0.0f10/skills/mipsync-cli/SKILL.md")
    message(FATAL_ERROR "Latest formal editor did not receive its skills")
endif()
foreach(_version IN ITEMS v2026.10.18 v1.0.0f2)
    if(EXISTS "${WORK_DIR}/installs/${_version}/skills")
        message(FATAL_ERROR "Deployment selected an older editor")
    endif()
endforeach()
