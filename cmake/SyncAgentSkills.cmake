cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED DESTINATION_DIR OR
   NOT EXISTS "${SOURCE_DIR}/mipsync-cli/SKILL.md")
    message(FATAL_ERROR "SyncAgentSkills requires a bundled SOURCE_DIR and DESTINATION_DIR")
endif()
if(SOURCE_DIR STREQUAL DESTINATION_DIR)
    message(FATAL_ERROR "Skill source and destination must differ")
endif()
set(_copy copy_directory)
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.26)
    set(_copy copy_directory_if_different)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E ${_copy} "${SOURCE_DIR}" "${DESTINATION_DIR}"
    RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Failed to synchronize bundled Agent Skills")
endif()
# Remove retired bundled references as well as replacing changed files.
file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${DESTINATION_DIR}" "${DESTINATION_DIR}/*")
foreach(_file IN LISTS _files)
    if(NOT EXISTS "${SOURCE_DIR}/${_file}")
        file(REMOVE "${DESTINATION_DIR}/${_file}")
    endif()
endforeach()
