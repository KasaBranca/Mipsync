# Compile this small, authored SVG into ImDrawList commands. No raster cache or
# runtime SVG dependency is required; geometry comes directly from script.svg.
# The artwork uses convex M/L/C/Z paths and rectangles with two palette roles.
function(compile_inspector_script_icon source output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" svg)
    string(REGEX MATCH "viewBox=\"0 0 ([0-9.]+) ([0-9.]+)\"" bounds "${svg}")
    if(NOT bounds)
        message(FATAL_ERROR "Script SVG requires an origin-based viewBox")
    endif()
    set(width "${CMAKE_MATCH_1}")
    set(height "${CMAKE_MATCH_2}")
    set(code "// Generated from resources/icons/project/script.svg; do not edit.\n#pragma once\n#include <imgui.h>\n#include <algorithm>\nnamespace MipsyncEngine {\ninline void DrawProjectScriptSvgIcon(ImDrawList* dl, ImVec2 min, ImVec2 max, ImU32 background, ImU32 foreground) {\n    const float scale = std::min((max.x-min.x)/${width}.0f, (max.y-min.y)/${height}.0f);\n    const ImVec2 origin(min.x + ((max.x-min.x)-${width}.0f*scale)*0.5f, min.y + ((max.y-min.y)-${height}.0f*scale)*0.5f);\n    auto p = [&](float x, float y) { return ImVec2(origin.x+x*scale, origin.y+y*scale); };\n")
    string(REGEX MATCHALL "<(path|rect)[^>]+/>" shapes "${svg}")
    if(NOT shapes)
        message(FATAL_ERROR "Script SVG contains no supported shapes")
    endif()
    foreach(shape IN LISTS shapes)
        string(REGEX MATCH "data-role=\"(background|foreground)\"" role "${shape}")
        if(NOT role)
            message(FATAL_ERROR "Script SVG shape has no palette role")
        endif()
        set(color "${CMAKE_MATCH_1}")
        if(shape MATCHES "^<rect")
            foreach(attribute x y width height)
                string(REGEX MATCH " ${attribute}=\"([0-9.]+)\"" value "${shape}")
                if(NOT value)
                    message(FATAL_ERROR "Script SVG rectangle lacks ${attribute}")
                endif()
                set(${attribute} "${CMAKE_MATCH_1}")
            endforeach()
            string(APPEND code "    dl->AddRectFilled(p(${x}, ${y}), p(${x}+${width}, ${y}+${height}), ${color});\n")
        else()
            string(REGEX MATCH " d=\"([^\"]+)\"" path "${shape}")
            set(data "${CMAKE_MATCH_1}")
            string(REGEX MATCHALL "[A-Za-z]|-?[0-9]+(\\.[0-9]+)?" tokens "${data}")
            string(APPEND code "    dl->PathClear();\n")
            while(tokens)
                list(POP_FRONT tokens command)
                if(command STREQUAL "M" OR command STREQUAL "L")
                    list(POP_FRONT tokens x y)
                    string(APPEND code "    dl->PathLineTo(p(${x}, ${y}));\n")
                elseif(command STREQUAL "C")
                    list(POP_FRONT tokens x1 y1 x2 y2 x y)
                    string(APPEND code "    dl->PathBezierCubicCurveTo(p(${x1}, ${y1}), p(${x2}, ${y2}), p(${x}, ${y}));\n")
                elseif(command STREQUAL "Z")
                    string(APPEND code "    dl->PathFillConvex(${color});\n")
                else()
                    message(FATAL_ERROR "Unsupported script SVG path command: ${command}")
                endif()
            endwhile()
        endif()
    endforeach()
    string(APPEND code "}\n} // namespace MipsyncEngine\n")
    # Avoid forcing a rebuild when an unrelated CMake setting changes.
    file(WRITE "${output}.tmp" "${code}")
    configure_file("${output}.tmp" "${output}" COPYONLY)
    file(REMOVE "${output}.tmp")
endfunction()
