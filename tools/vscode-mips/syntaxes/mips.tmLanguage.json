{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mips#",
  "scopeName": "source.mips",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#members"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mips",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mips",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mips",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mips",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.class.mips",
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.mips"
            },
            "2": {
              "name": "entity.name.type.class.mips"
            }
          }
        },
        {
          "name": "meta.enum.mips",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.mips"
            },
            "2": {
              "name": "entity.name.type.enum.mips"
            }
          }
        },
        {
          "name": "meta.function.mips",
          "match": "\\b(?:public\\s+|private\\s+)?(?:void|bool|int|float|string|IEnumerator|Vector3|AudioClip|Entity|Transform|Animator|AudioSource|Collider|Rigidbody|[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.mips"
            }
          }
        },
        {
          "name": "meta.field.mips",
          "match": "\\b(public|private)\\s+(?:bool|int|float|string|Vector3|AudioClip|Entity|Transform|Animator|AudioSource|Collider|Rigidbody|[A-Za-z_][A-Za-z0-9_]*(?:\\[\\])?)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.mips"
            },
            "2": {
              "name": "variable.other.member.mips"
            }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "support.function.member.mips",
          "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.member.mips"
            }
          }
        },
        {
          "name": "variable.other.property.mips",
          "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.property.mips"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.mips",
          "match": "\\b(?!if\\b|for\\b|while\\b|switch\\b|return\\b|new\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.mips"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mips",
          "match": "\\b(if|else|while|for|break|continue|return|yield)\\b"
        },
        {
          "name": "storage.modifier.mips",
          "match": "\\b(public|private)\\b"
        },
        {
          "name": "storage.type.mips",
          "match": "\\b(class|enum|var|new|void|bool|int|float|string)\\b"
        },
        {
          "name": "constant.language.boolean.mips",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.mips",
          "match": "\\b(MipsBehaviour|IEnumerator|WaitForSeconds|AudioClip|Entity|Transform|Vector3|Animator|AudioSource|Collider|Rigidbody)\\b"
        },
        {
          "name": "support.class.mips",
          "match": "\\b(Time|Input|Log|Debug|Mathf|Physics|Scene|Application|Save)\\b"
        }
      ]
    }
  }
}
