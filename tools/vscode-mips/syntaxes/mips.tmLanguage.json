{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mips#",
  "scopeName": "source.mips",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#members"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mips",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mips",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mips",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mips",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mips",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.mips"
            },
            "2": {
              "name": "entity.name.type.mips"
            }
          }
        },
        {
          "match": "\\b(?:(public)\\s+)?((?!if\\b|else\\b|while\\b|for\\b|return\\b|yield\\b|break\\b|continue\\b|new\\b|class\\b|enum\\b|var\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[\\s*\\])?)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.mips"
            },
            "2": {
              "name": "support.type.mips",
              "patterns": [
                {
                  "match": "\\b(void|bool|int|float|string)\\b",
                  "name": "storage.type.mips"
                }
              ]
            },
            "3": {
              "name": "entity.name.function.mips"
            }
          }
        },
        {
          "match": "\\b(public)\\s+((?!if\\b|else\\b|while\\b|for\\b|return\\b|yield\\b|break\\b|continue\\b|new\\b|class\\b|enum\\b|var\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[\\s*\\])?)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.mips"
            },
            "2": {
              "name": "support.type.mips",
              "patterns": [
                {
                  "match": "\\b(void|bool|int|float|string)\\b",
                  "name": "storage.type.mips"
                }
              ]
            },
            "3": {
              "name": "variable.other.member.mips"
            }
          }
        },
        {
          "match": "\\b(var|[A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[\\s*\\])?)\\s+((?!if\\b|else\\b|while\\b|for\\b|return\\b|yield\\b|break\\b|continue\\b|new\\b|class\\b|enum\\b|var\\b)[A-Za-z_][A-Za-z0-9_]*)\\s*(?==|;|,|\\)|\\{)",
          "captures": {
            "1": {
              "name": "storage.type.mips"
            },
            "2": {
              "name": "variable.other.local.mips"
            }
          }
        },
        {
          "match": "\\b(GetComponent)\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(>)",
          "captures": {
            "1": {
              "name": "support.function.mips"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.mips"
            },
            "3": {
              "name": "support.type.mips",
              "patterns": [
                {
                  "match": "\\b(void|bool|int|float|string)\\b",
                  "name": "storage.type.mips"
                }
              ]
            },
            "4": {
              "name": "punctuation.definition.typeparameters.end.mips"
            }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "support.function.member.mips",
          "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.member.mips"
            }
          }
        },
        {
          "name": "variable.other.property.mips",
          "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.property.mips"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.mips",
          "match": "\\b(?!if\\b|for\\b|while\\b|switch\\b|return\\b|new\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.mips"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mips",
          "match": "\\b(if|else|while|for|break|continue|return|yield|extends)\\b"
        },
        {
          "name": "storage.modifier.mips",
          "match": "\\b(public|private|get|set)\\b"
        },
        {
          "name": "storage.type.mips",
          "match": "\\b(class|enum|var|new|void|bool|int|float|string)\\b"
        },
        {
          "name": "constant.language.boolean.mips",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.mips",
          "match": "\\b(MipsBehaviour|IEnumerator|WaitForSeconds|AudioClip|Entity|Camera|Transform|Vector3|Animator|AudioSource|Collider|Rigidbody)\\b"
        },
        {
          "name": "support.class.mips",
          "match": "\\b(Time|Input|Log|Debug|Mathf|Physics|Camera|UI|Scene|Application|Save)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mips",
          "match": "==|!=|<=|>=|&&|\\|\\||[+*/%=!<>-]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.mips",
          "match": "[{}()\\[\\],;:.]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.mips",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "begin": "\\[(?=\\s*(?:Header|Space|Tooltip|Range|Min|ReadOnly|HideInInspector|InspectorName|Order)(?:Attribute)?\\b)",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.begin.mips"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.end.mips"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "name": "support.type.attribute.mips",
          "match": "\\b(?:Header|Space|Tooltip|Range|Min|ReadOnly|HideInInspector|InspectorName|Order)(?:Attribute)?\\b"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    }
  }
}
